#!/bin/bash
# WMT OS First-Boot Service
#
# Applies setup.ini (with sane fallbacks), generates SSH keys,
# grows the rootfs, and makes a swap file.
#
# Copyright (C) 2026 Logan Russell <me@lrussell.net>

declare -A cfg
ini=/boot/uboot/setup.ini
if [ -f "$ini" ]; then
	while IFS='=' read -r k v || [[ $k ]]; do [[ $k ]] && cfg[$k]=${v%$'\r'}; done < "$ini"
	shred -u "$ini" # Holds plaintext passwords
fi

hostname=${cfg[Hostname]:-wmt-os}
keymap=${cfg[Keymap]:-us}
rootpw=${cfg[RootPassword]:-root}
timezone=${cfg[Timezone]:-UTC}
username=${cfg[UserName]:-wmt-user}
userpw=${cfg[UserPassword]:-wmt-user}

echo "$hostname" > /etc/hostname
hostname "$hostname"
sed -i "2i 127.0.1.1\t$hostname" /etc/hosts

[ -e "/usr/share/zoneinfo/$timezone" ] || timezone=UTC
ln -sf "/usr/share/zoneinfo/$timezone" /etc/localtime
echo "$timezone" > /etc/timezone

[ -e "/usr/share/X11/xkb/symbols/$keymap" ] || keymap=us
if [ "$keymap" != us ]; then
	# Layouts that cannot type Latin keep us first, as Debian's installer does
	ckbcomp -layout "$keymap" | grep -q "= +U+0061" || keymap="us,$keymap" toggle=grp:alt_shift_toggle,grp_led:scroll
	sed -i "s|^XKBLAYOUT=.*|XKBLAYOUT=\"$keymap\"|; s|^XKBOPTIONS=.*|XKBOPTIONS=\"$toggle\"|" /etc/default/keyboard
	setupcon -k --force --save
	udevadm trigger --subsystem-match=input --action=change
fi

echo "root:$rootpw" | chpasswd

adduser --disabled-password --gecos "" "$username"
adduser "$username" sudo
echo "$username:$userpw" | chpasswd

for t in rsa ecdsa ed25519; do
	key="/etc/dropbear/dropbear_${t}_host_key"
	[ -f "$key" ] || dropbearkey -t "$t" -f "$key"
done

growpart /dev/mmcblk0 2
resize2fs /dev/mmcblk0p2

fallocate -l 256M /swapfile
chmod 600 /swapfile
mkswap /swapfile
printf '/swapfile\tnone\t\tswap\tdefaults\t0\t0\n' >> /etc/fstab
systemctl daemon-reload
swapon -a

sync
